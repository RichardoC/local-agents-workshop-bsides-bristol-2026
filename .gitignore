# --- workshop additions ---

# pi writes runtime state into the agent dir; only models.json is committed.
.pi/agent/sessions/
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/auth.json

# The model itself is ~1.5GB. Download it, don't commit it.
# The .exe form matters: the README tells Windows users to rename it.
*.llamafile
*.llamafile.exe

# Created if anyone runs npm install, which the optional Node path makes likely.
package-lock.json

# The pi static build, extracted here by attendees (~110 MB).
/pi/
/pi
/pi.exe

# Release archives, if downloaded into the repo folder.
pi-*-x64.tar.gz
pi-*-arm64.tar.gz
pi-windows-*.zip
SHA256SUMS

# OS and editor cruft. .DS_Store in particular gets committed by accident on
# every macOS project, and attendees are about to publish these repositories.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
